<clickhouse>
    <users>
        <clickhouseUser1>
            <password>clickhouseUser1</password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>1</access_management>
        </clickhouseUser1>
    </users>

    <profiles>
        <default>
            <do_not_merge_across_partitions_select_final>1</do_not_merge_across_partitions_select_final>
            <final>1</final>
            <optimize_on_insert>1</optimize_on_insert>

            <!-- Per-query memory limits -->
            <max_memory_usage>150000000</max_memory_usage>
            <max_memory_usage_for_user>300000000</max_memory_usage_for_user>

            <!-- Limit query threads -->
            <max_threads>2</max_threads>
            <max_insert_threads>1</max_insert_threads>

            <!-- Limit network buffers -->
            <max_read_buffer_size>1048576</max_read_buffer_size>
        </default>
    </profiles>
</clickhouse>
